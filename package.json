{
  "name": "kagelin",
  "version": "1.4.0",
  "description": "Kagelin - Local-first personal productivity and task management",
  "author": "roverstargazer1-max",
  "license": "AGPL-3.0-only",
  "private": false,
  "main": "dist-electron/main.js",
  "scripts": {
    "electron:compile": "tsc -p tsconfig.electron.json --noEmit && node scripts/bundle-electron.cjs",
    "copy:standalone": "node scripts/copy-standalone.cjs",
    "electron:build:local": "cross-env NEXT_PUBLIC_IS_ELECTRON=true npm run build && npm run copy:standalone && npm run electron:compile && electron-builder --win --publish never",
    "electron:build:mac": "cross-env NEXT_PUBLIC_IS_ELECTRON=true npm run build && npm run copy:standalone && npm run electron:compile && electron-builder --mac --publish never",
    "electron:build:mac:arm64": "cross-env NEXT_PUBLIC_IS_ELECTRON=true npm run build && npm run copy:standalone && npm run electron:compile && electron-builder --mac --arm64 --publish never",
    "electron:build:ci": "cross-env NEXT_PUBLIC_IS_ELECTRON=true npm run build && npm run copy:standalone && npm run electron:compile && electron-builder --publish always",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "dev": "next dev --turbo",
    "dev:pwa": "next dev --webpack",
    "prebuild": "npm run copy-wasm",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint src app supabase --max-warnings=13",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "validate": "npm-run-all --parallel format:check lint:strict typecheck test",
    "validate:fix": "npm run format && npm run validate",
    "ci:validate": "cross-env CI=true npm run validate && npm run build",
    "e2e": "playwright test",
    "analyze": "npx cross-env ANALYZE=true npm run build",
    "dead-code": "npx knip",
    "unused-deps": "npx depcheck",
    "copy-wasm": "node -e \"require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'public/sql-wasm.wasm')\"",
    "preview": "node scripts/release.cjs --channel=preview",
    "release": "node scripts/release.cjs --channel=stable",
    "prepare": "husky && npm run copy-wasm",
    "mcp:start": "tsx mcp-server/index.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@sentry/nextjs": "^10.65.0",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "ical-generator": "^11.0.0",
    "ical.js": "^2.2.1",
    "idb-keyval": "^6.3.0",
    "ipaddr.js": "^2.4.0",
    "lucide-react": "^1.24.0",
    "mermaid": "^12.0.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-activity-calendar": "^3.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-tooltip": "^6.0.8",
    "react-virtuoso": "^4.18.10",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.4.2",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "tsdav": "^2.3.1",
    "tsx": "^4.23.13",
    "undici": "^8.7.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@poupe/eslint-plugin-tailwindcss": "^0.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.17",
    "prettier": "^3.9.5",
    "release-it": "^20.2.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "build": {
    "appId": "com.kagelin.desktop",
    "productName": "Kagelin",
    "directories": {
      "output": "dist-electron-build"
    },
    "files": [
      "dist-electron/**/*",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": ".",
        "filter": [
          "standalone/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.mts",
          "!**/*.d.cts",
          "!**/node_modules/.cache/**",
          "!**/*.md",
          "!**/README*",
          "!**/LICENSE*"
        ]
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kagelin",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "roverstargazer1-max",
        "repo": "to-do",
        "releaseType": "release"
      }
    ]
  }
}
